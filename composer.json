{
    "name": "studioespresso/craft-easyaddressfield",
    "description": "The only address field you need",
    "type": "craft-plugin",
    "version": "6.0.0-beta.2",
    "keywords": [
        "cms",
        "craftcms",
        "fieldtype",
        "address"
    ],
    "authors": [
        {
            "name": "Studio Espresso",
            "homepage": "https://www.studioespresso.co"
        }
    ],
    "support": {
        "email": "support@studioespresso.co",
        "issues": "https://github.com/studioespresso/craft-easyaddressfield/issues",
        "docs": "https://github.com/studioespresso/craft-easyaddressfield/blob/develop-v6/README.MD"
    },
    "require": {
        "php": ">=8.5",
        "craftcms/cms": "^6.0.0-beta.2",
        "league/iso3166": "^4.7.1",
        "giggsey/locale": "^2.10.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32.3",
        "orchestra/testbench": "^11.3"
    },
    "scripts": {
        "check-cs": "pint --test",
        "fix-cs": "pint",
        "phpstan": "phpstan --memory-limit=1G",
        "ci": "pint && phpstan --memory-limit=1G"
    },
    "autoload": {
        "psr-4": {
            "studioespresso\\easyaddressfield\\": "src/"
        },
        "files": [
            "src/aliases.php"
        ]
    },
    "extra": {
        "name": "Easy Address Field",
        "handle": "easy-address-field",
        "class": "studioespresso\\easyaddressfield\\EasyAddressField"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
